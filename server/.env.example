# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=your_mongodb_connection_string

# Authentication (JSON Web Token Secret)
JWT_SECRET=your_jwt_secret_key

# Frontend Client URL (For constructing password reset links)
CLIENT_URL=http://localhost:5173

# Email Delivery / SMTP Configuration (Optional)
# In development, if unconfigured, password reset links are safely previewed in server logs.
# For production email delivery, configure any standard SMTP provider (e.g. SendGrid, Mailtrap, AWS SES, Gmail):
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
FROM_EMAIL=noreply@careervista.com
FROM_NAME="CareerVista Support"
